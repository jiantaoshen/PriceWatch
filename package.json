{
  "name": "pricewatch",
  "private": true,
  "workspaces": [
    "web",
    "private-web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "node scripts/dev-stack.mjs web frontend",
    "dev:private": "node scripts/dev-stack.mjs private frontend",
    "build:web": "npm run build --workspace=web",
    "build:private": "npm run build --workspace=pricewatch-private-web",
    "lint:web": "npm run lint --workspace=web",
    "lint:private": "npm run lint --workspace=pricewatch-private-web",
    "lint": "npm run lint:web && npm run lint:private",
    "dev:web:api": "node scripts/dev-stack.mjs web backend",
    "dev:web:all": "node scripts/dev-stack.mjs web all",
    "dev:private:api": "node scripts/dev-stack.mjs private backend",
    "private:run-once": "node scripts/dev-stack.mjs private run-once",
    "dev:private:all": "node scripts/dev-stack.mjs private all",
    "db:update": "node scripts/dev-stack.mjs web migrate"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
