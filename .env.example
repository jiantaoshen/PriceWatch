# ============================================================
# PriceWatch local development
# Copy this file to .env.local and fill in the values you use.
# .env.local is ignored by git.
# ============================================================

# Shared database used by both web API and private API.
DATABASE_CONNECTION_STRING=

# ------------------------------------------------------------
# Cloud/web stack (web + PriceWatch.WebApi)
# ------------------------------------------------------------
WEB_FRONTEND_URL=http://localhost:3000
WEB_API_URL=http://localhost:5128

# Microsoft login used by the Next.js web frontend.
WEB_MICROSOFT_CLIENT_ID=
WEB_MICROSOFT_TENANT=consumers
WEB_API_SCOPE=
WEB_MICROSOFT_REDIRECT_URI=http://localhost:3000/redirect

# Owner-only API authorization. Fill at least one.
OWNER_SUB=
OWNER_OID=

# Optional Web API AzureAd overrides. Leave blank to use appsettings.json.
API_MICROSOFT_CLIENT_ID=
API_MICROSOFT_TENANT=

# ------------------------------------------------------------
# Local/private stack (private-web + PriceWatch.Private)
# ------------------------------------------------------------
PRIVATE_FRONTEND_URL=http://localhost:3001
PRIVATE_API_URL=http://127.0.0.1:5188

# Optional private scraper overrides.
# On Windows with the repo venv, use: .venv/Scripts/python.exe
PRIVATE_PYTHON_EXECUTABLE=.venv/Scripts/python.exe
PRIVATE_PYTHON_SCRIPT=scraper/worker.py
PRIVATE_HEADLESS=true
PRIVATE_SUSPICIOUS_CHANGE_RATIO=0.80
